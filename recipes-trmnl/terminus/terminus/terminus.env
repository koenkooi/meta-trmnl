RACK_ENV=production
HANAMI_ENV=production
HANAMI_SERVE_ASSETS=true
BUNDLE_GEMFILE=/usr/lib/terminus/app/Gemfile
BUNDLE_WITHOUT=development:quality:test:tools
# No BUNDLE_PATH/BUNDLE_DEPLOYMENT: this app's gems come from two separate
# GEM_HOMEs (this recipe's own private vendor dir for pure-Ruby gems, plus
# meta-rubygems' packages for native-extension ones, installed into the
# system gem dir) -- deployment mode only ever looks in one BUNDLE_PATH.
# Plain GEM_PATH covers both; Ruby 4.0 needs an explicit rubygems require.
GEM_PATH=/usr/lib/terminus/vendor/bundle/ruby/4.0.0:/usr/lib/ruby/gems/4.0.0
RUBYOPT=-rrubygems
# With no BUNDLE_PATH set, `bundle exec` resolves an executable by prepending
# Bundler.bundle_path/bin (the SYSTEM gem home) to PATH -- fine for puma
# (a meta-rubygems package, installed there) but not hanami-cli, whose
# bin/hanami stub lives only in this app's private vendor GEM_HOME above.
# `bundle exec hanami ...` needs that dir on PATH explicitly.
PATH=/usr/lib/terminus/vendor/bundle/ruby/4.0.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
DATABASE_URL=postgres://terminus:terminus@127.0.0.1:5432/terminus
KEYVALUE_URL=redis://127.0.0.1:6379/0
APP_SECRET=changeme-boot-test-only-not-for-production-use-64-chars-minimum-x
API_URI=http://127.0.0.1:2300
HANAMI_PORT=2300
