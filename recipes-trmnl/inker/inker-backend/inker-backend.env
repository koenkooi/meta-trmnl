NODE_ENV=production
PORT=3002
DATABASE_URL=file:/var/lib/inker/inker.db
SCREENS_DIR=/var/lib/inker/uploads/screens
FIRMWARE_DIR=/var/lib/inker/uploads/firmware
HOME=/usr/lib/inker-backend/app
PRISMA_QUERY_ENGINE_LIBRARY=/usr/lib/inker-backend/app/prisma-engines/libquery_engine.so.node
PRISMA_SCHEMA_ENGINE_BINARY=/usr/lib/inker-backend/app/prisma-engines/schema-engine
PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
