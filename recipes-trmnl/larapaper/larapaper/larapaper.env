# Boot-test only: values from upstream .env.example, adjusted for a
# qemuarm64 test image with no Chromium/Puppeteer wired up yet (see
# meta-trmnl README). APP_KEY is upstream's own published example key,
# not a secret -- same reasoning as terminus.env's placeholder APP_SECRET.
APP_NAME=LaraPaper
APP_ENV=production
APP_KEY=base64:zzPXBQPlgn0NHwVBTVG0B//8P/PVwVnBp2gk0ZWR0+k=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/larapaper/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

REGISTRATION_ENABLED=1

# No target Chromium yet. Not a blocker for the default device-pairing
# path (setup-logo/sleep images ship pre-rendered), but a real plugin
# needing Browsershot to render markup will fail until Chromium lands.
PUPPETEER_MODE=local
PUPPETEER_DOCKER=false
